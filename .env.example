# Lead Intelligence Platform — example configuration.
# Copy to .env and edit. Nothing in this repository reads .env implicitly;
# `make dev` sources it, and the binaries read real environment variables.
#
# Names prefixed UPVISTA_ are ours. The handful of unprefixed names
# (DATABASE_URL, HTTP_ADDR, LOG_LEVEL, LOG_FORMAT) are the ecosystem
# conventions — they work unprefixed, and the UPVISTA_ form wins if both
# are set, so a deployment can always be explicit.

# ─── Runtime ────────────────────────────────────────────────────────────────
UPVISTA_ENV=development
LOG_LEVEL=info
LOG_FORMAT=json
HTTP_ADDR=:8080

# ─── Database ───────────────────────────────────────────────────────────────
# Postgres is required. The platform ships migrations for every module.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/leads?sslmode=disable
UPVISTA_DB_MAX_CONNS=16
UPVISTA_DB_MIN_CONNS=2
UPVISTA_DB_CONNECT_TIMEOUT=10s
UPVISTA_DB_STATEMENT_TIMEOUT=30s

# ─── Crawler (crawld) ───────────────────────────────────────────────────────
# Identification. A crawler that does not say who it is is a crawler that
# gets blocked; a real contact address here is what earns that cooperation.
CRAWLER_USER_AGENT=UpvistaBot/1.0 (+https://upvista.example/bot)

# Politeness. The defaults are deliberately slow. Raising concurrency past a
# few workers against a third-party site is how you get a block, not a crawl.
CRAWLER_CONCURRENCY=4
CRAWLER_PER_HOST_DELAY=1s
CRAWLER_HOST_RATE=1
CRAWLER_HOST_BURST=2

# Limits.
CRAWLER_MAX_BYTES=2097152
CRAWLER_MAX_RETRIES=2

# robots.txt is obeyed. Setting this to a truthy value is a legal decision you
# are making for every host you touch, and the service logs a warning when it
# is off. There is no reason to set it in production.
# CRAWLER_RESPECT_ROBOTS_DISABLED=

# Lets the crawler reach loopback and private addresses. Off by default because
# a crawler that can reach internal networks is a request-forgery gadget.
# Only ever set this for local development.
# CRAWLER_ALLOW_PRIVATE_HOSTS=

# ─── Optional providers ─────────────────────────────────────────────────────
# Every provider is optional and pluggable. With no keys configured the
# pipeline still runs end to end using public web + heuristic research.
# UPVISTA_BRAVE_API_KEY=
# UPVISTA_TAVILY_API_KEY=
# UPVISTA_LLM_API_KEY=
# UPVISTA_LLM_MODEL=
